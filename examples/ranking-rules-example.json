[
  {
    "name": "Boost New Arrivals",
    "description": "Boost products that arrived in the last 30 days",
    "trackingId": "fashion_store",
    "enabled": true,
    "action": "boost",
    "conditions": [
      {
        "field": "ec_category",
        "operator": "equals",
        "values": ["summer-collection"]
      }
    ],
    "definition": {
      "boostFactor": 100
    }
  },
  {
    "name": "Bury Out of Stock Items",
    "description": "Demote products that are out of stock",
    "trackingId": "fashion_store",
    "enabled": true,
    "action": "bury",
    "conditions": [
      {
        "field": "ec_in_stock",
        "operator": "equals",
        "value": "false"
      }
    ],
    "definition": {
      "boostFactor": -500
    }
  },
  {
    "name": "Promote High Margin Products",
    "description": "Boost products with high profit margins",
    "trackingId": "fashion_store",
    "enabled": true,
    "action": "boost",
    "conditions": [
      {
        "field": "ec_margin_percent",
        "operator": "greaterThan",
        "value": 40
      }
    ],
    "definition": {
      "boostFactor": 50
    }
  },
  {
    "name": "Pin Featured Product",
    "description": "Pin a specific product to position 1",
    "trackingId": "fashion_store",
    "enabled": true,
    "action": "pin",
    "conditions": [
      {
        "field": "ec_product_id",
        "operator": "equals",
        "value": "PROD-12345"
      }
    ],
    "definition": {
      "position": 1
    }
  },
  {
    "name": "Reserve Top 3 for Sponsored",
    "description": "Reserve top 3 positions for sponsored products",
    "trackingId": "fashion_store",
    "enabled": true,
    "action": "reservedPosition",
    "conditions": [
      {
        "field": "ec_sponsored",
        "operator": "equals",
        "value": "true"
      }
    ],
    "definition": {
      "position": 3
    }
  }
]
